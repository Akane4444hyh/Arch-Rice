{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/Pictures/fastfetch/fastfetch.txt",
    "color": {"1": "magenta"},
    "width": 5,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "title": "#f2eef5",
      "output": "#f2eef5"
    }
  },

  "modules": [
    "break",

    {
      "type": "os",
      "key": "OS",
      "keyColor": "#d7a6f3"
    },

    {
      "type": "kernel",
      "key": " ├   KER ",
      "keyColor": "#d7a6f3"
    },

    {
      "type": "packages",
      "key": " ├   PAK ",
      "format": "{all}",
      "keyColor": "#d7a6f3"
    },

    {
      "type": "title",
      "key": " └   USR ",
      "keyColor": "#d7a6f3"
    },

    "break",
    "break",

    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#b8b6ff"
    },

    {
      "type": "de",
      "key": " ├ 󱈹  DES ",
      "keyColor": "#b8b6ff"
    },

    {
      "type": "shell",
      "key": " ├   SHE ",
      "keyColor": "#b8b6ff"
    },

    {
      "type": "terminal",
      "key": " ├   TER ",
      "keyColor": "#b8b6ff"
    },

    {
      "type": "terminalfont",
      "key": " └   TFO ",
      "keyColor": "#b8b6ff"
    },

    "break",
    "break",

    {
      "type": "host",
      "key": "PC ",
      "keyColor": "#ebe6f5"
    },

    {
      "type": "cpu",
      "key": " ├   CPU ",
      "keyColor": "#ebe6f5"
    },

    {
      "type": "memory",
      "key": " ├   MEM ",
      "keyColor": "#ebe6f5"
    },

    {
      "type": "gpu",
      "key": " ├ 󰢮  GPU ",
      "format": "{1} {2}",
      "keyColor": "#ebe6f5"
    },

    {
      "type": "display",
      "key": " ├   MON ",
      "format": "{name} {width}x{height}@{refresh-rate} ",
      "keyColor": "#ebe6f5"
    },

    {
      "type": "disk",
      "key": " └ 󰋊  DIS ",
      "keyColor": "#ebe6f5"
    },

    "break",
    "break",
    "colors"
  ]
}
